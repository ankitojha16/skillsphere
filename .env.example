# SkillSphere Environment Variables Template (Safe Configuration)
# Copy this file to .env and configure with your local or production credentials

SECRET_KEY=your-secure-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillsphere_db

# Discrete PostgreSQL Settings:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=skillsphere_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Set to True to allow automatic fallback to SQLite when local PostgreSQL is offline
USE_SQLITE_FALLBACK=True

# Optional: Shared Distributed Cache (Redis / Upstash / AWS ElastiCache)
# When set, enables multi-instance cache consistency across all Vercel serverless containers.
# If omitted, Django safely defaults to In-Memory LocMemCache.
# REDIS_URL=rediss://default:password@your-redis-endpoint.upstash.io:6379

# Optional: AI Service Integrations
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Email SMTP Server Configuration
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_sendgrid_key_here
# DEFAULT_FROM_EMAIL=SkillSphere <noreply@skillsphere.app>
