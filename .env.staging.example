# SkillSphere Staging Environment Configuration Template
# Copy this file to .env.staging and populate with secure, isolated staging credentials.
# NEVER commit the populated .env.staging file to version control.

# -----------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=staging-insecure-secret-key-replace-with-kms-generated-value-48chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,staging.skillsphere.cloud,*.elb.amazonaws.com
ENVIRONMENT=staging

# -----------------------------------------------------------------------------
# 2. ISOLATED STAGING DATABASE (PostgreSQL with PgBouncer)
# -----------------------------------------------------------------------------
# Must point to an ISOLATED staging database instance, NEVER production!
DATABASE_URL=postgres://skillsphere_staging_user:staging_secure_password_123@staging-db.internal:5432/skillsphere_staging
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_RESERVE_POOL_SIZE=10

# -----------------------------------------------------------------------------
# 3. DISTRIBUTED CACHE & TASK BROKER (Redis)
# -----------------------------------------------------------------------------
REDIS_URL=redis://:staging_redis_secret@staging-redis.internal:6379/0
REDIS_CACHE_URL=redis://:staging_redis_secret@staging-redis.internal:6379/1

# -----------------------------------------------------------------------------
# 4. PROVIDER-INDEPENDENT OBJECT STORAGE (S3 / R2 / MinIO)
# -----------------------------------------------------------------------------
# Supported backends: s3, r2, minio, supabase, local
STORAGE_BACKEND=s3
STORAGE_BUCKET_NAME=skillsphere-staging-media
STORAGE_REGION_NAME=ap-south-1
STORAGE_ACCESS_KEY=your-staging-storage-access-key-here
STORAGE_SECRET_KEY=your-staging-storage-secret-key-here
# Optional custom endpoint (for Cloudflare R2, MinIO, or Supabase Storage):
# STORAGE_ENDPOINT_URL=https://c8219abf182.r2.cloudflarestorage.com
# STORAGE_PUBLIC_URL_BASE=https://cdn-staging.skillsphere.cloud
# Set to 'path' for MinIO or R2; leave unset for AWS S3:
# STORAGE_S3_ADDRESSING_STYLE=virtual
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=False

# -----------------------------------------------------------------------------
# 5. ASYNCHRONOUS WORKER DAEMON CONFIGURATION
# -----------------------------------------------------------------------------
WORKER_POLL_INTERVAL=0.5
WORKER_LEASE_GRACE_SECONDS=30
WORKER_IDLE_BACKOFF=2.0
MAX_TASK_RETRIES=3

# -----------------------------------------------------------------------------
# 6. OBSERVABILITY & SECURITY
# -----------------------------------------------------------------------------
PROMETHEUS_METRICS_ENABLED=True
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
